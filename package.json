{
  "name": "controle-versoes",
  "version": "0.1.0",
  "private": true,
  "description": "Controle de versões de projetos de engenharia e arquitetura — protótipo para validação com a equipe",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node servidor.js",
    "recomecar": "node src/persistencia/seed.js --recriar",
    "backup": "node ferramentas/backup.mjs",
    "test": "node verificacao/executar.mjs",
    "test:ui": "npm --prefix frontend run smoke",
    "verificar": "node verificacao/executar.mjs",
    "app": "npm --prefix frontend run dev",
    "app:build": "npm --prefix frontend run build",
    "build": "npm --prefix frontend install && npm --prefix frontend run build"
  }
}
